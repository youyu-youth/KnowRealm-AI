{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnowRealm",
  "version": "0.1.0",
  "identifier": "ai.knowrealm.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KnowRealm",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:*",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:*",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "binaries/*.dll": ".",
      "binaries/ffmpeg-runtime/LICENSE.txt": "licenses/ffmpeg/LICENSE.txt",
      "binaries/ffmpeg-runtime/SOURCE.txt": "licenses/ffmpeg/SOURCE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
